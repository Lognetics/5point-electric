# Public URL of the live site, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Enquiry delivery (https://resend.com). Without these, production forms return an error
# rather than silently losing enquiries. In development, enquiries go to .data/enquiries.ndjson.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Optional Cloudflare Turnstile spam protection. Set both to enable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CMS sign-in: GitHub OAuth app, callback URL https://<your-domain>/api/cms/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
